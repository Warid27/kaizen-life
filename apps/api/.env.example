# Local dev secrets for the API (`wrangler dev`) — copy to `apps/api/.dev.vars`.
# `.dev.vars` is gitignored and only applies to local dev; values here override
# `[vars]` in wrangler.toml when running `wrangler dev`.

# REQUIRED: without this, local dev inherits ENVIRONMENT=production from
# wrangler.toml and the production CORS rules block http://localhost:4321,
# making every API call from the web app fail silently in the browser.
ENVIRONMENT=development

# Real auth (optional locally): when set, the API enforces session cookies —
# every non-auth request without one gets 401 and the web app redirects to
# /login. Unset = frictionless dev with the shared default-user identity.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Optional: PBKDF2 iterations for password hashing (default 100000).
# Lower it (min 10000) if free-tier Workers CPU limits reject logins.
# PBKDF2_ITERATIONS=100000

# Web Push (optional — push notifications stay disabled when unset).
# Generate a fresh ECDH P-256 pair with any VAPID key generator.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
