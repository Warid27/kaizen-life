---
import '../styles/global.css';
import CommandPaletteMount from '../islands/CommandPaletteMount';
import ReminderBell from '../components/shared/ReminderBell';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'KaizenLife', description = 'Become 1% Better Every Day' } = Astro.props;

const today = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const navSections = [
  {
    label: 'Today',
    items: [
      { icon: 'dashboard', label: 'Dashboard', href: '/' },
      { icon: 'planner', label: 'Daily Planner', href: '/planner' },
    ],
  },
  {
    label: 'Life',
    items: [
      { icon: 'habits', label: 'Habits', href: '/life/habits' },
      { icon: 'checkin', label: 'Daily Check-In', href: '/life/checkin' },
      { icon: 'diary', label: 'Diary', href: '/life/diary' },
    ],
  },
  {
    label: 'College',
    items: [
      { icon: 'schedule', label: 'Schedule', href: '/college/schedule' },
      { icon: 'assignments', label: 'Assignments', href: '/college/assignments' },
      { icon: 'semester', label: 'Semester', href: '/college/semester' },
    ],
  },
  {
    label: 'Work',
    items: [
      { icon: 'standup', label: 'Daily Standup', href: '/work/standup' },
      { icon: 'projects', label: 'Projects', href: '/work/projects' },
      { icon: 'clients', label: 'Clients', href: '/work/clients' },
      { icon: 'meetings', label: 'Meetings', href: '/work/meetings' },
    ],
  },
  {
    label: 'Finance',
    items: [
      { icon: 'finance', label: 'Transactions', href: '/finance' },
    ],
  },
  {
    label: 'Review & Goals',
    items: [
      { icon: 'goals', label: 'Goals', href: '/review/goals' },
      { icon: 'monthly', label: 'Monthly Review', href: '/review/monthly' },
      { icon: 'stats', label: 'Statistics', href: '/review/stats' },
    ],
  },
  {
    label: 'System',
    items: [
      { icon: 'changelog', label: 'Changelog', href: '/changelog' },
      { icon: 'status', label: 'Status', href: '/status' },
    ],
  },
];

// Mobile bottom tab bar items
const mobileNavItems = [
  { icon: 'dashboard', label: 'Today', href: '/' },
  { icon: 'habits', label: 'Life', href: '/life/habits' },
  { icon: 'standup', label: 'Work', href: '/work/standup' },
  { icon: 'more', label: 'More', href: '/settings' },
];

const iconSvgs: Record<string, string> = {
  dashboard: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  planner: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  habits: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  checkin: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  diary: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  schedule: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="14" x2="8" y2="14.01"/><line x1="12" y1="14" x2="12" y2="14.01"/><line x1="16" y1="14" x2="16" y2="14.01"/><line x1="8" y1="18" x2="8" y2="18.01"/><line x1="12" y1="18" x2="12" y2="18.01"/>',
  assignments: '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="m9 14 2 2 4-4"/>',
  semester: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  standup: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  projects: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  clients: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  meetings: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  finance: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  goals: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  monthly: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  stats: '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  more: '<circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/>',
  changelog: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  status: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
};
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- PWA Meta Tags -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="KaizenLife" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />

    <title>{title}</title>
  </head>
  <body class="h-full overflow-hidden">
    <div class="flex h-full">
      <!-- Desktop Sidebar -->
      <aside
        id="sidebar"
        class="sidebar hidden md:flex w-64 flex-col border-r border-sidebar-border bg-sidebar text-sidebar-foreground transition-all duration-300"
      >
        <!-- Sidebar Header -->
        <div class="flex h-14 items-center gap-2 border-b border-sidebar-border px-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
            <span class="text-sm font-bold">K</span>
          </div>
          <span class="sidebar-label text-lg font-semibold tracking-tight">KaizenLife</span>
          <button
            id="sidebar-toggle"
            class="ml-auto rounded-md p-1.5 text-sidebar-foreground/60 hover:bg-sidebar-accent hover:text-sidebar-foreground"
            aria-label="Toggle sidebar"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
        </div>

        <!-- Nav Sections -->
        <nav class="flex-1 overflow-y-auto py-3">
          {navSections.map((section) => (
            <div class="mb-2">
              <div class="sidebar-label mb-1 px-4 text-[10px] font-semibold uppercase tracking-wider text-sidebar-foreground/40">
                {section.label}
              </div>
              {section.items.map((item) => {
                const currentPath = Astro.url.pathname;
                const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
                return (
                  <a
                    href={item.href}
                    class:list={[
                      'sidebar-link group mx-2 flex items-center gap-3 rounded-md px-3 py-1.5 text-sm transition-colors',
                      isActive
                        ? 'bg-sidebar-accent font-medium text-sidebar-foreground'
                        : 'text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-foreground',
                    ]}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="shrink-0"
                      set:html={iconSvgs[item.icon]}
                    />
                    <span class="sidebar-label truncate">{item.label}</span>
                  </a>
                );
              })}
            </div>
          ))}
        </nav>

        <!-- Sidebar Footer -->
        <div class="border-t border-sidebar-border px-2 py-2">
          <a
            href="/settings"
            class="sidebar-link group flex items-center gap-3 rounded-md px-3 py-1.5 text-sm text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0"
              set:html={iconSvgs['settings']}
            />
            <span class="sidebar-label">Settings</span>
          </a>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex flex-1 flex-col overflow-hidden">
        <!-- Topbar -->
        <header class="flex h-14 items-center justify-between border-b border-border bg-background px-4">
          <div class="flex items-center gap-3">
            <h1 class="text-sm font-semibold text-foreground">{today}</h1>
          </div>

          <div class="flex items-center gap-2">
            <!-- Reminder Bell -->
            <ReminderBell client:load />

            <!-- Command Palette Trigger (hidden on mobile) -->
            <button
              id="cmd-palette-trigger"
              class="hidden sm:flex items-center gap-2 rounded-md border border-border bg-secondary/50 px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-secondary"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
              <span>Search...</span>
              <kbd class="ml-2 rounded border border-border bg-background px-1.5 py-0.5 text-[10px] font-medium">⌘K</kbd>
            </button>

            <!-- Quick Capture Button -->
            <button
              id="quick-capture-btn"
              class="flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
              </svg>
              <span class="hidden sm:inline">Capture</span>
            </button>
          </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 overflow-y-auto pb-16 md:pb-0">
          <slot />
        </main>
      </div>
    </div>

    <!-- Mobile Bottom Tab Bar -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 border-t border-border bg-background">
      <div class="flex h-14 items-center justify-around">
        {mobileNavItems.map((item) => {
          const currentPath = Astro.url.pathname;
          const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'flex flex-col items-center gap-0.5 px-3 py-1 text-xs transition-colors',
                isActive
                  ? 'text-primary font-medium'
                  : 'text-muted-foreground hover:text-foreground',
              ]}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={iconSvgs[item.icon]}
              />
              <span>{item.label}</span>
            </a>
          );
        })}
      </div>
    </nav>

    <!-- Command Palette (React Island) -->
    <CommandPaletteMount client:load />

    <script>
      // Register Service Worker for PWA
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // SW registration failed silently
          });
        });
      }
    </script>

    <style>
      /* Collapsed sidebar state */
      .sidebar.collapsed {
        width: 56px;
      }
      .sidebar.collapsed .sidebar-label,
      .sidebar.collapsed .sidebar-link span {
        display: none;
      }
      .sidebar.collapsed .sidebar-link {
        justify-content: center;
        padding-left: 0;
        padding-right: 0;
      }

      /* Transition for sidebar elements */
      .sidebar-label,
      .sidebar-link span {
        transition: opacity 0.2s ease;
      }
    </style>

    <script>
      const sidebar = document.getElementById('sidebar');
      const toggle = document.getElementById('sidebar-toggle');

      if (toggle && sidebar) {
        toggle.addEventListener('click', () => {
          sidebar.classList.toggle('collapsed');
        });
      }

      // Command palette trigger — dispatch event for React island
      const cmdPalette = document.getElementById('cmd-palette-trigger');
      if (cmdPalette) {
        cmdPalette.addEventListener('click', () => {
          document.dispatchEvent(new CustomEvent('kaizenlife:open-cmd-palette'));
        });
      }

      // Quick capture — dispatch event for React island
      const quickCapture = document.getElementById('quick-capture-btn');
      if (quickCapture) {
        quickCapture.addEventListener('click', () => {
          document.dispatchEvent(new CustomEvent('kaizenlife:quick-capture'));
        });
      }
    </script>
  </body>
</html>
