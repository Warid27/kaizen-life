---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as Changelog } from '../../../../CHANGELOG.md';
---

<BaseLayout title="Changelog — KaizenLife" description="Track all changes and updates to KaizenLife">
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Changelog
      </h1>
      <p class="mt-2 text-muted-foreground">
        All notable changes to KaizenLife, documented here.
      </p>
    </div>

    <div class="changelog-content">
      <Changelog />
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Base prose ── */
  .changelog-content {
    color: hsl(var(--foreground));
    line-height: 1.75;
    font-size: 0.9375rem;
  }

  /* ── Headings ── */
  .changelog-content :global(h1) {
    display: none; /* Hide the top-level "# Changelog" — we render our own header */
  }

  .changelog-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: hsl(var(--foreground));
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .changelog-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: hsl(var(--foreground));
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  /* ── Paragraphs ── */
  .changelog-content :global(p) {
    margin-bottom: 1rem;
    color: hsl(var(--muted-foreground));
  }

  .changelog-content :global(a) {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .changelog-content :global(a:hover) {
    color: hsl(var(--primary) / 0.8);
  }

  .changelog-content :global(strong) {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  /* ── Lists ── */
  .changelog-content :global(ul),
  .changelog-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .changelog-content :global(li) {
    margin-bottom: 0.375rem;
    color: hsl(var(--muted-foreground));
  }

  .changelog-content :global(li:last-child) {
    margin-bottom: 0;
  }

  .changelog-content :global(li::marker) {
    color: hsl(var(--muted-foreground) / 0.5);
  }

  /* ── Horizontal rules ── */
  .changelog-content :global(hr) {
    border: none;
    border-top: 1px solid hsl(var(--border));
    margin: 2rem 0;
  }

  /* ── Inline code ── */
  .changelog-content :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    background: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
    padding: 0.125rem 0.375rem;
    border-radius: calc(var(--radius) - 2px);
    border: 1px solid hsl(var(--border));
  }

  /* ── Code blocks ── */
  .changelog-content :global(pre) {
    margin-bottom: 1rem;
    overflow-x: auto;
    border-radius: var(--radius);
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    padding: 1rem;
  }

  .changelog-content :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 0.8125rem;
    color: hsl(var(--foreground));
  }

  /* ── Tables ── */
  .changelog-content :global(table) {
    width: 100%;
    margin-bottom: 1rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .changelog-content :global(thead) {
    border-bottom: 2px solid hsl(var(--border));
  }

  .changelog-content :global(th) {
    text-align: left;
    padding: 0.625rem 1rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    font-size: 0.8125rem;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  .changelog-content :global(td) {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
  }

  .changelog-content :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .changelog-content :global(tbody tr:hover) {
    background: hsl(var(--muted) / 0.5);
  }

  /* ── Blockquotes ── */
  .changelog-content :global(blockquote) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid hsl(var(--primary));
    background: hsl(var(--muted) / 0.5);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: hsl(var(--muted-foreground));
  }

  .changelog-content :global(blockquote p) {
    margin-bottom: 0;
  }
</style>
