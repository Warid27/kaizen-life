{
  "name": "kaizenlife",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@kaizenlife/web",
    "build": "npm run build --workspace=@kaizenlife/web",
    "dev:web": "npm run dev --workspace=@kaizenlife/web",
    "build:web": "npm run build --workspace=@kaizenlife/web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^12.2.0",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}